# Copy to .env (gitignored) and fill in values.
# These are build-time variables: Vite inlines them into the client bundle.

VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_SUBDL_API_KEY=your_subdl_api_key_here

# --- Backend (server.js / Vercel functions) ---
# Required in production. Generate one with: openssl rand -hex 32
JWT_SECRET=your_long_random_secret

# Optional comma-separated browser origins allowed to call the API directly.
# Leave empty when the API and UI are served from the same origin.
ALLOWED_ORIGINS=

# Optional durable key/value store (Vercel KV or Upstash Redis REST).
# Without these the server falls back to a local JSON file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
